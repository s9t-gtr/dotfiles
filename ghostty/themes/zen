# zen — 静寂。白磁の背景に水色(青系)のアクセント。
# 日本の伝統色ベース: 白磁 #f8fafb / 藍鼠(墨) #3f5666 / 浅葱 #3a97ac
# 縹 #4a7fa5 / 瓶覗 #dceef4 / 白群 #55b0c4

background = #f8fafb
foreground = #3f5666

cursor-color = #3a97ac
cursor-text = #f8fafb

selection-background = #cfe7f0
selection-foreground = #2e4152

# 0: 藍鼠(dark) / 8: 薄藍鼠(CLIの薄文字用。薄すぎると読めないので3:1強を確保)
palette = 0=#46606f
palette = 8=#7d94a2
