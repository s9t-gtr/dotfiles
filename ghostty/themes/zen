palette = 1=#b25d5d
palette = 9=#c47272
# 2/10: 青磁(muted green)
palette = 2=#5f9982
palette = 10=#6fae94
# 3/11: 芥子(muted amber)
palette = 3=#9c823a
palette = 11=#b09a4d
# 4/12: 縹(blue)
palette = 4=#4a7fa5
palette = 12=#5b93c4
# 5/13: 藤(muted violet)
palette = 5=#8677ad
palette = 13=#9b8cc4
