#!/bin/sh
# workmode: 作業モードを切り替え、tmux のアクセント色と Ghostty の背景を
# まとめて変える。狙いは「色の心理効果」ではなく、能動的な切替という
# 儀式（事象境界）と、モード⇔見た目の一貫反復による習慣トリガー化。
#
# usage:
#   workmode <mode> [-m]     モードを切り替える（-m で切替前に resume メモ）
#   workmode --status        現在のモードを表示
#   workmode                 現在のモードを表示（--status と同じ）
#
# mode: coding | review | research | writing | break
#
# break は「タイマー強制」ではなく自己起動の休憩儀式。作業画像を消して
# 画面から作業を外し（デタッチメント）、自然・運動系の休憩活動を提示する。
# 休憩の回復効果は再現性が高い（活力 d=0.36 / 疲労 d=0.35, Albulescu 2022）が、
# 生産性直接効果は弱い。狙いは集中力ブーストでなく回復と持続可能性。

set -e

# tmux 等は /opt/homebrew/bin にあるが、tmux run-shell（prefix+W・起動時復元）の
# PATH は最小でそこを含まない。tmux 連携が無言でスキップされるのを防ぐため補う。
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

DOTFILES="$HOME/dotfiles"
MODES_DIR="$DOTFILES/tmux/modes"
IMAGES_ROOT="$DOTFILES/ghostty/images"
STATE_FILE="$HOME/.config/workmode"
BG_CONF="$HOME/.config/ghostty/background.conf"

VALID_MODES="coding review research writing break"

usage() {
  echo "usage: workmode {coding|review|research|writing} [-m] | --status" >&2
  exit 1
}

# --- 引数パース -------------------------------------------------------------
MODE=""
MEMO=0
for arg in "$@"; do
  case "$arg" in
    -m|--memo) MEMO=1 ;;
    --status)  MODE="__status__" ;;
    -*)        usage ;;
    *)         MODE="$arg" ;;
  esac
done

# 引数なし or --status: 現在モードを表示して終了
if [ -z "$MODE" ] || [ "$MODE" = "__status__" ]; then
  cat "$STATE_FILE" 2>/dev/null || echo "coding"
  exit 0
fi

# モードの検証
case " $VALID_MODES " in
  *" $MODE "*) : ;;
  *) echo "workmode: unknown mode '$MODE'" >&2; usage ;;
esac

# --- モード定義（ティント色・行動ヒント）-----------------------------------
# TINT: gruber-darker の bg #181818 に極薄く色を混ぜた背景色
# HINT: 切替時に表示する if-then 形式の行動意図リマインド
case "$MODE" in
  coding)
    TINT="181818"
    HINT="CODING — まず1ファイル・1関数に集中。着手前に失敗するテストを1本書く" ;;
  review)
    TINT="1c1a14"
    HINT="REVIEW — PR一覧を開き、1件目のdiffだけを最後まで読む" ;;
  research)
    TINT="161a16"
    HINT="RESEARCH — 問いを1行で書き出してから調べ始める。脱線は別タブへ退避" ;;
  writing)
    TINT="17161a"
    HINT="WRITING — 見出しだけ先に並べる。推敲は後、まず通しで書き切る" ;;
  break)
    # 休憩は作業モードと明確に違う暖色ティント。画像は出さず作業を視界から外す
    TINT="1a1613"
    HINT="BREAK — 席を立とう。同じ画面のままSNSは回復が弱い。体を動かすか外を見る" ;;
esac

# --- 冪等ガード: 同じモードなら何もしない（起動時復元の二重実行を防ぐ）-----
PREV="$(cat "$STATE_FILE" 2>/dev/null || echo "")"
if [ "$PREV" = "$MODE" ] && [ "$MEMO" = "0" ]; then
  exit 0
fi

# --- (0) 切替前に resume メモ（-m 指定時のみ、オプトイン）--------------------
# 前タスクの「どこまで/次の一手」を1行残すと注意残余が減る (Leroy & Glomb 2018)
#
# tmux display-popup は非同期（呼び出し元はポップアップを開いた時点で即座に
# 制御を取り戻す）。そのため何もせず後続の (1)-(7) に進むと、ユーザーが
# ポップアップにまだ打鍵している最中に tmux source-file（全ペイン再描画）や
# OSC11 の直接 tty 書き込みが割り込み、日次メモが文字化けする不具合があった。
# workmode-memo が入力完了時に作る DONE_FLAG を待ってから後続処理へ進む。
if [ "$MEMO" = "1" ] && [ -n "$PREV" ] && command -v tmux >/dev/null 2>&1; then
  DONE_FLAG="$(mktemp -t workmode-memo-done 2>/dev/null || echo "/tmp/workmode-memo-done.$$")"
  rm -f "$DONE_FLAG"
  tmux display-popup -w 80% -h 40% \
    -s "bg=#181818,fg=#e4e4ef" -S "fg=#ffdd33" \
    -E "$DOTFILES/bin/workmode-memo '$PREV' '$MODE' '$DONE_FLAG'" 2>/dev/null || true
  i=0
  while [ ! -f "$DONE_FLAG" ] && [ "$i" -lt 600 ]; do
    sleep 0.1
    i=$((i + 1))
  done
  rm -f "$DONE_FLAG"
fi

# --- (1) 状態の永続化 -------------------------------------------------------
mkdir -p "$(dirname "$STATE_FILE")"
echo "$MODE" > "$STATE_FILE"

# --- (2) tmux: モード別 conf を読み込みアクセント色を全ウィンドウへ波及 ------
if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux set-environment -g WORK_MODE "$MODE"
  [ -f "$MODES_DIR/$MODE.conf" ] && tmux source-file "$MODES_DIR/$MODE.conf"
fi

# --- (3) Ghostty 背景設定を書き換え（モード別ディレクトリからランダム選択）---
mkdir -p "$(dirname "$BG_CONF")"
IMAGES_DIR="$IMAGES_ROOT/$MODE"
chosen=$(
  find "$IMAGES_DIR" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null \
  | awk 'BEGIN{srand()} {a[NR]=$0} END{if(NR>0)print a[int(rand()*NR)+1]}'
)
{
  echo "background = $TINT"
  if [ -n "$chosen" ]; then
    echo "background-image = $chosen"
    echo "background-image-position = center"
    echo "background-image-fit = cover"
    echo "background-image-opacity = 0.1"
  fi
} > "$BG_CONF"

# --- (4) Ghostty に設定リロードを通知（1.2.0+ の SIGUSR2）-------------------
# コマンドを固定し、他プロセスへの誤送を避ける
pkill -USR2 -x ghostty 2>/dev/null || true

# nvim にもモード変更を通知（~/dotfiles/nvim/lua/config/workmode.lua が
# SIGUSR1 を受けて CursorLineNr 等のアクセント色だけ更新する。colorscheme
# 自体は変えない）。同一ユーザーの全 nvim インスタンスに送る
pkill -USR1 -x nvim 2>/dev/null || true

# --- (5) OSC 11 で背景色を即時反映（画像リロードが即効かない場合の保険）------
# 各 tmux クライアントの tty に直接送る。tmux 外なら現在の端末へ。
osc="$(printf '\033]11;#%s\033\\' "$TINT")"
if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  for tty in $(tmux list-clients -F '#{client_tty}' 2>/dev/null); do
    printf '%s' "$osc" > "$tty" 2>/dev/null || true
  done
else
  printf '%s' "$osc"
fi

# --- (6) if-then リマインドを表示 ------------------------------------------
# 必ず OSC 送信の後に出す。先に出すと OSC 11（背景色変更）に伴う画面再描画で
# メッセージが即クリアされてしまう。break は popup を出すので HINT は省く。
if [ "$MODE" != "break" ] && command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux display-message -d 3500 "$HINT" 2>/dev/null || true
fi

# --- (7) break は休憩ガイドを popup 表示（背景・色を適用した後に出す）--------
# 自己起動・自己終了。Enter で閉じるまで待つ＝離席・デタッチメントの時間を確保。
if [ "$MODE" = "break" ] && command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux display-popup -w 60% -h 45% \
    -s "bg=#1a1613,fg=#e4e4ef" -S "fg=#cc8c3c" \
    -E "$DOTFILES/bin/workmode-break" 2>/dev/null || true
fi

exit 0
