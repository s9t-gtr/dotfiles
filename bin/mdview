#!/bin/bash
# markdownをHTMLに変換してデフォルトブラウザで開く
# 使い方: mdview <file.md>
set -e

if [ $# -lt 1 ] || [ ! -f "$1" ]; then
  echo "usage: mdview <file.md>" >&2
  exit 1
fi

src="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
out="${TMPDIR:-/tmp}/mdview-$(basename "${src%.*}").html"
style="$(mktemp)"
trap 'rm -f "$style"' EXIT

cat > "$style" <<'EOF'
<style>
  :root {
    color-scheme: light dark;
    --bg: #fffcf0;
    --fg: #100f0f;
    --muted: #6f6e69;
    --border: #e6e4d9;
    --code-bg: #f2f0e5;
    --accent: #205ea6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #100f0f;
      --fg: #cecdc3;
      --muted: #878580;
      --border: #343331;
      --code-bg: #1c1b1a;
      --accent: #4385be;
    }
  }
  body {
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, "Hiragino Sans", sans-serif;
    line-height: 1.7;
    max-width: 46rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
  }
  h1, h2, h3, h4 { line-height: 1.3; margin: 2rem 0 0.8rem; }
  h1 { font-size: 1.7rem; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
  h2 { font-size: 1.35rem; border-bottom: 1px solid var(--border); padding-bottom: 0.3rem; }
  h3 { font-size: 1.1rem; }
  a { color: var(--accent); }
  code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.875em;
    background: var(--code-bg);
    border-radius: 4px;
    padding: 0.15em 0.35em;
  }
  pre {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.9rem 1.1rem;
    overflow-x: auto;
  }
  pre code { background: none; padding: 0; }
  blockquote {
    margin: 1rem 0;
    padding: 0.1rem 1rem;
    border-left: 3px solid var(--border);
    color: var(--muted);
  }
  table { border-collapse: collapse; margin: 1rem 0; display: block; overflow-x: auto; }
  th, td { border: 1px solid var(--border); padding: 0.4rem 0.8rem; text-align: left; }
  th { background: var(--code-bg); }
  hr { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }
  img { max-width: 100%; }
</style>
EOF

pandoc -s -f gfm --wrap=preserve -H "$style" \
  --metadata title="$(basename "$src")" \
  "$src" -o "$out"

open "$out"
