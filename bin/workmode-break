#!/bin/sh
# workmode-break: break モード起動時に tmux display-popup 内で実行される休憩ガイド。
# 自然・運動系を優先した休憩活動をランダムに1つ提示する（自然 > 受動的スクリーン）。
# タイマーは持たず、ユーザーが Enter で閉じるまで待つ＝離席・デタッチメントの時間を確保。
# 毎回文言を変えて馴化（慣れて無視される失敗パターン）を遅らせる。

# 休憩活動候補（運動・自然を優先度高め）。区切りは | 。
ACTIVITIES="🚶 散歩に出る — 数分でも外の光と空気を。窓の外の緑を眺めるだけでも回復する|🧘 立ち上がって伸びる — 肩・首・背中を10秒ずつ。座りっぱなしを断ち切る|☕ 一杯淹れに行く — 席を離れて水分補給。歩くこと自体がタスクの区切りになる|👀 遠くを見る — 20秒間、6m以上先をぼんやり眺めて目を休める|🌬 呼吸を整える — 4秒吸って8秒吐くを5回。目を閉じて画面から意識を外す"

# ランダムに1つ選ぶ（awk srand で毎回変える）
pick=$(printf '%s' "$ACTIVITIES" | awk 'BEGIN{srand()} {n=split($0,a,"|"); print a[int(rand()*n)+1]}')

clear 2>/dev/null || true
printf '\n'
printf '   ╭─────────────────────────────────────────╮\n'
printf '   │              b r e a k                    │\n'
printf '   ╰─────────────────────────────────────────╯\n'
printf '\n'
printf '   いま作業から離れます。\n'
printf '\n'
printf '     %s\n' "$pick"
printf '\n'
printf '   ・戻る準備ができたら Enter を押す\n'
printf '   ・作業再開時は  wm <前のモード>  で戻る\n'
printf '     （どこまでやったか一言メモするなら -m 付き）\n'
printf '\n'
printf '   Enter で閉じる…'
read -r _ 2>/dev/null || true
