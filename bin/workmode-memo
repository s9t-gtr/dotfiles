#!/bin/sh
# workmode-memo: モード切替前に「ready-to-resume メモ」を1行書き留めるヘルパ。
# tmux display-popup 内で実行される。切替直前の旧タスクの「どこまで/次の一手」を
# 残すと注意残余が減り次タスクの成績が上がる（Leroy & Glomb 2018）。
#
# usage: workmode-memo <prev_mode> <next_mode> [done_flag]
# メモは既存の日次メモ（prefix+m と同じ Obsidian ファイル）に追記する。
#
# done_flag: 呼び出し元の workmode が、この popup が閉じる（＝入力完了）まで
# 後続処理（tmux source-file・OSC11・pkill 等）を止めておくための完了通知先。
# tmux display-popup は非同期に起動するため、これが無いと打鍵中に workmode
# 本体の画面書き換えが割り込み、日次メモが文字化けする不具合があった。

PREV="${1:-?}"
NEXT="${2:-?}"
DONE_FLAG="${3:-}"

MEMO_DIR="$HOME/Obsidian/MEMO"
MEMO_FILE="$MEMO_DIR/$(date +%Y-%m-%d).md"

# tmux display-popup は画面表示とキー入力転送の確立の間にわずかなラグがあり、
# 表示直後に打鍵すると先頭〜途中の入力が欠落する（日本語入力の途中バイトが
# 消え、日次メモが文字化けする不具合の原因だった）。転送確立を待つための猶予。
sleep 0.3 2>/dev/null || true

clear 2>/dev/null || true
printf '\n'
printf '   [%s → %s] への切替メモ\n' "$PREV" "$NEXT"
printf '   %s を再開するとき最初にやる一手は？（空Enterでスキップ）\n' "$PREV"
printf '\n   > '
read -r note 2>/dev/null || note=""

if [ -n "$note" ]; then
  mkdir -p "$MEMO_DIR"
  # 時刻つきで日次メモに追記（既存の prefix+m メモと同じファイル）
  printf -- '- `%s` [resume:%s] %s\n' "$(date +%H:%M)" "$PREV" "$note" >> "$MEMO_FILE"
  printf '\n   記録しました。\n'
  sleep 1 2>/dev/null || true
fi

# 入力完了を呼び出し元に通知（popup が閉じる直前＝最後に行う）
[ -n "$DONE_FLAG" ] && touch "$DONE_FLAG" 2>/dev/null || true
